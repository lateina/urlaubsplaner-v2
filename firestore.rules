rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hilfsfunktion für Admin-Check (Unterstützt alle Apps)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'Administrator' || 
        request.auth.token.role == 'admin' ||
        request.auth.uid == 'admin' ||
        (exists(/databases/$(database)/documents/users_v2/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users_v2/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function hasAccess() {
      return request.auth != null && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users_v2/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users_v2/$(request.auth.uid)).data.role == 'Sekretariat')
      );
    }

    // --- Rotationsplaner V2 Collections ---
    match /structures_v2/{structId} {
      allow read, write: if request.auth != null;
    }
    match /grid_layouts/{layoutId} {
      allow read, write: if request.auth != null;
    }
    match /rotations_v2/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /users_v2/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    match /quarters_v2/{quarterId} {
      allow read, write: if request.auth != null;
    }
    match /periods_v2/{periodId} {
      allow read, write: if request.auth != null;
    }

    // --- Hausdienstchat / Rotationstool Collections ---
    match /users/{userId} {
      allow read: if true; // Öffentlich lesbar für Login-Suche
      allow write: if isAdmin();
      
      match /rotations/{document} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
      }
    }
    
    match /distributions/{distId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /fcm_tokens/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // --- Planer570 State ---
    match /planer_app_state/{document=**} {
      allow read, write: if isAdmin();
    }

    // --- Urlaubsplaner V2 (Standalone) ---
    match /up_absences/{docId} {
      allow read, write: if request.auth != null;
    }
    match /up_requests/{reqId} {
      allow read, write: if request.auth != null;
    }
    match /up_errors/{document=**} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    
    // --- Gemeinsame Konfiguration (Mitarbeiter) ---
    match /up_config/{document} {
      allow read: if true;
      allow write: if true; // Allow public write to fix access for anonymous admin/users
    }
    
    // --- Journal Watch Planer ---
    match /journal_watch/{document} {
      allow read: if true;
      allow write: if true; // Allow public write to fix access for anonymous admin/users
    }

    match /jw_publish_jobs/{jobId} {
      allow read, write: if true;
    }
  }
}
